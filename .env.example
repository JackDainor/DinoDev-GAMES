# Shop2TopUp: create a NEW key after rotating any key shared in chat.
SHOP2TOPUP_API_KEY=YOUR_KEY_ID.YOUR_SECRET
SHOP2TOPUP_BASE_URL=https://shop2topup.com/api/endpoints/v1

# Neon connection string (include sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Keep false until you deliberately want provider wallet charges from test order endpoint.
ALLOW_TEST_ORDERS=false

# Local payment (QR)
# USD → local rates (adjust to your margin)
RATE_USD_BOB=12
RATE_USD_BRL=5.45
# Public image URLs of your payment QR codes (host on Vercel public/, Imgur, etc.)
QR_URL_BO=https://example.com/qr-bolivia.png
QR_URL_BR=https://example.com/qr-brasil.png

# Secret to confirm payment + fulfill via Shop2TopUp (do not expose to browser)
OPERATOR_SECRET=change-me-long-random
